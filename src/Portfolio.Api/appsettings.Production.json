{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=portfolio_db;User=root;Password=;CharSet=utf8mb4;"
  },
  "Github": {
    "Username": "your-github-username",
    "Token": "",
    "CacheMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/portfolio-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  }
}
